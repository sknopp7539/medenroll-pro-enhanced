graph TB
    subgraph "User Role Hierarchy"
        Admin["👑 Administrator<br/>Full System Access"]
        Manager["✏️ Manager<br/>Create & Update"]
        Viewer["👀 Viewer<br/>Read Only"]
        
        Admin -->|"Inherits all permissions"| Manager
        Manager -->|"Inherits all permissions"| Viewer
    end
    
    subgraph "Admin Permissions"
        A1["✅ View all data"]
        A2["✅ Create providers"]
        A3["✅ Edit providers"]
        A4["✅ Delete providers"]
        A5["✅ Export reports"]
        A6["✅ Manage users"]
        A7["✅ Change roles"]
        A8["✅ System settings"]
        
        Admin --> A1
        Admin --> A2
        Admin --> A3
        Admin --> A4
        Admin --> A5
        Admin --> A6
        Admin --> A7
        Admin --> A8
    end
    
    subgraph "Manager Permissions"
        M1["✅ View all data"]
        M2["✅ Create providers"]
        M3["✅ Edit providers"]
        M4["❌ Delete providers"]
        M5["✅ Export reports"]
        M6["❌ Manage users"]
        
        Manager --> M1
        Manager --> M2
        Manager --> M3
        Manager --> M4
        Manager --> M5
        Manager --> M6
    end
    
    subgraph "Viewer Permissions"
        V1["✅ View all data"]
        V2["❌ Create providers"]
        V3["❌ Edit providers"]
        V4["❌ Delete providers"]
        V5["❌ Export reports"]
        V6["❌ Manage users"]
        
        Viewer --> V1
        Viewer --> V2
        Viewer --> V3
        Viewer --> V4
        Viewer --> V5
        Viewer --> V6
    end
    
    subgraph "Access Control"
        UserManagement["🛡️ User Management Dashboard<br/>Admin Only"]
        ProviderCRUD["📝 Provider CRUD<br/>Manager & Admin"]
        ViewData["👁️ View Data<br/>All Roles"]
        
        Admin -.->|"Can access"| UserManagement
        Admin -.->|"Can access"| ProviderCRUD
        Manager -.->|"Can access"| ProviderCRUD
        Admin -.->|"Can access"| ViewData
        Manager -.->|"Can access"| ViewData
        Viewer -.->|"Can access"| ViewData
    end
    
    subgraph "Role Assignment Flow"
        NewUser["🆕 New User<br/>First Login"]
        StartViewer["Assigned: Viewer"]
        PromoteManager["Admin promotes to Manager"]
        PromoteAdmin["Admin promotes to Admin"]
        
        NewUser --> StartViewer
        StartViewer -.->|"If needs edit access"| PromoteManager
        PromoteManager -.->|"If needs full access"| PromoteAdmin
    end
    
    style Admin fill:#ffcdd2
    style Manager fill:#bbdefb
    style Viewer fill:#f5f5f5
    style UserManagement fill:#fff9c4
    style A4 fill:#ffebee
    style A6 fill:#ffebee
    style A7 fill:#ffebee

